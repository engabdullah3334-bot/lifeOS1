# =====================================================================
# Life OS — Environment Configuration Template (.env.example)
# انسخ هذا الملف إلى .env وقم بملء القيم الخاصة بك
# =====================================================================

# ──  Flask & Security Settings ───────────────────────────────────────
FLASK_ENV=development
FLASK_PORT=5000
JWT_SECRET_KEY=change-this-to-a-very-strong-and-secure-random-secret-key
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ── Database (MongoDB) ───────────────────────────────────────────────
# ضع رابط الاتصال بقاعدة بيانات MongoDB (سواء محلي أو على MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=LifeOS

# ── AI Provider Settings ────────────────────────────────────────────
# الخيارات المتاحة: gemini | grok | ollama
AI_PROVIDER=gemini

# 1. Google Gemini API (المزود الافتراضي)
# احصل على المفتاح مجاناً من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. xAI Grok API (اختياري)
# احصل على المفتاح من: https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-beta

# 3. Ollama - Local AI (اختياري للتشغيل المحلي بالكامل)
# قم بتحميل وتثبيت Ollama من: https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
AI_REQUEST_TIMEOUT=30
